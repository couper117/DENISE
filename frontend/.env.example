# Your Render backend URL — no trailing slash
# After deploying to Render, replace with your actual URL
# e.g. https://denise-textile-api.onrender.com/api
VITE_API_URL=https://denise-textile-api.onrender.com/api

VITE_APP_NAME=DENISE Textile

# Google Analytics 4 (optional — get from analytics.google.com)
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Google Maps embed key (optional — Contact page)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
