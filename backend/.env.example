# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# Your production frontend domain — NO trailing slash
FRONTEND_URL=https://deniseshop.com
FRONTEND_URL_ALT=https://www.deniseshop.com

# ─── Database ─────────────────────────────────────────────────────────────────
# Aiven for PostgreSQL: copy the "Service URI" from the Aiven console. It already
# ends with ?sslmode=require — keep that, Aiven refuses non-SSL connections.
#   postgresql://avnadmin:PASSWORD@pg-xxxx.aivencloud.com:PORT/defaultdb?sslmode=require
# If you enable Aiven connection pooling (PgBouncer), point DATABASE_URL at the
# pooled URI and add DIRECT_URL with the primary URI for `prisma migrate deploy`.
DATABASE_URL="postgresql://avnadmin:password@pg-xxxx.aivencloud.com:12345/defaultdb?sslmode=require"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Checked at startup: both are required, must be at least 32 characters, must
# differ from each other, and must not be left at these placeholders.
JWT_SECRET=replace-with-64-byte-random-hex
JWT_REFRESH_SECRET=replace-with-different-64-byte-random-hex
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cloudinary (image hosting) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=DENISE Textile <noreply@deniseshop.com>

# ─── Twilio (SMS & WhatsApp) — leave blank to disable ────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── Admin ────────────────────────────────────────────────────────────────────
# ADMIN_PASSWORD has no default and must be at least 12 characters — seeding
# fails without it rather than falling back to a password published in this file.
# Generate with: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_EMAIL=admin@deniseshop.com
ADMIN_PASSWORD=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
