generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  PREPARING
  PROCESSING
  PACKED
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  RESERVATION
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  MTN_MOMO
  AIRTEL_MONEY
  VISA
  MASTERCARD
  AMEX
  BANK_TRANSFER
  FLUTTERWAVE
  PAYPAL
  STRIPE
  PAY_AT_SHOP
}

enum PaymentStatus {
  AWAITING
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DeliveryType {
  SAME_DAY
  NEXT_DAY
  SCHEDULED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum MeasurementOption {
  KNOW_MEASUREMENTS
  HELP_AT_SHOP
  WALK_IN_CONSULTATION
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                String   @id @default(uuid())
  email             String?  @unique
  phone             String   @unique
  password          String
  firstName         String
  lastName          String
  role              Role     @default(CUSTOMER)
  isActive          Boolean  @default(true)
  isEmailVerified   Boolean  @default(false)
  isPhoneVerified   Boolean  @default(false)
  preferredLanguage String   @default("en")
  darkMode          Boolean  @default(false)
  avatarUrl         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  refreshTokens    RefreshToken[]
  reservations     Reservation[]
  wishlist         WishlistItem[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
  reviews          ProductReview[]
  contentBlocks    ContentBlock[]    @relation("ContentBlockEditor")
  contentRevisions ContentRevision[] @relation("ContentRevisionAuthor")
  mediaAssets      MediaAsset[]      @relation("MediaUploader")
  siteSettings     SiteSetting[]     @relation("SiteSettingEditor")

  @@index([email])
  @@index([phone])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent       Category?             @relation("CategoryToCategory", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryToCategory")
  products     Product[]
  translations CategoryTranslation[]

  @@index([slug])
}

model CategoryTranslation {
  id          String  @id @default(uuid())
  categoryId  String
  language    String
  name        String
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, language])
}

model Product {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  description      String?
  specifications   String?
  material         String?
  priceRange       String?
  price            Float?
  salePrice        Float?
  pricePerMeter    Float?
  currency         String   @default("RWF")
  isAvailable      Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  isNewArrival     Boolean  @default(false)
  isOnPromotion    Boolean  @default(false)
  promotionText    String?
  canBeDelivered   Boolean  @default(true)
  canBuyOnline     Boolean  @default(true)
  categoryId       String
  sortOrder        Int      @default(0)
  viewCount        Int      @default(0)
  reservationCount Int      @default(0)
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category         Category             @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  colors           ProductColor[]
  inventory        Inventory?
  reservationItems ReservationItem[]
  wishlistItems    WishlistItem[]
  translations     ProductTranslation[]
  reviews          ProductReview[]

  @@index([slug])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([isNewArrival])
}

model ProductTranslation {
  id             String  @id @default(uuid())
  productId      String
  language       String
  name           String
  description    String?
  specifications String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, language])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  publicId  String?
  altText   String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductColor {
  id        String  @id @default(uuid())
  productId String
  name      String
  hexCode   String?
  imageUrl  String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductReview {
  id           String   @id @default(uuid())
  productId    String
  userId       String?
  customerName String
  rating       Int
  title        String?
  message      String
  isApproved   Boolean  @default(false)
  isVerified   Boolean  @default(false)
  helpfulCount Int      @default(0)
  createdAt    DateTime @default(now())

  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id])
  helpfulVotes ReviewHelpfulVote[]

  @@index([productId])
  @@index([isApproved])
}

/// One row per "was this helpful" vote. The unique constraint is what enforces
/// one vote per voter per review — doing it in the database rather than with a
/// read-then-write in the handler also closes the race between concurrent votes.
model ReviewHelpfulVote {
  id        String   @id @default(uuid())
  reviewId  String
  /// "user:<uuid>" for a signed-in voter, "ip:<address>" for a guest. A single
  /// non-null column because Postgres treats NULLs as distinct, so a nullable
  /// userId would not be deduplicated by a unique index.
  voterKey  String
  createdAt DateTime @default(now())

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, voterKey])
  @@index([reviewId])
}

model Inventory {
  id              String   @id @default(uuid())
  productId       String   @unique
  stockCount      Int      @default(0)
  metersAvailable Float?
  lowStockAlert   Int      @default(5)
  isTracked       Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model DeliveryAddress {
  id            String   @id @default(uuid())
  province      String
  district      String
  sector        String?
  cell          String?
  village       String?
  streetAddress String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())

  reservations Reservation[]
}

model DeliveryZone {
  id            String   @id @default(uuid())
  province      String
  // Empty string = province-wide zone. Must not be null: Postgres treats NULLs as
  // distinct in a unique index, so a nullable district lets @@unique below pass on
  // every province-wide upsert and insert duplicate zones.
  district      String   @default("")
  baseFee       Float
  currency      String   @default("RWF")
  isActive      Boolean  @default(true)
  estimatedDays Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([province, district])
}

model Payment {
  id              String        @id @default(uuid())
  reservationId   String
  method          PaymentMethod
  amount          Float
  currency        String        @default("RWF")
  status          PaymentStatus @default(PENDING)
  reference       String?       @unique
  gatewayResponse Json?
  phoneNumber     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
  @@index([reference])
}

model Reservation {
  id                String            @id @default(uuid())
  reservationNumber String            @unique
  qrCode            String?
  userId            String?
  customerName      String
  customerPhone     String
  customerEmail     String?
  preferredLanguage String            @default("en")
  fulfillmentType   FulfillmentType   @default(RESERVATION)
  visitDate         DateTime?
  visitTime         String?
  notes             String?
  measurementOption MeasurementOption @default(HELP_AT_SHOP)
  status            ReservationStatus @default(PENDING)
  /// Goods total before delivery, at the prices actually charged. Stored so an
  /// invoice reprinted months later still shows the breakdown the customer saw,
  /// even after the product's price has changed.
  subtotal          Float?
  /// Money saved against list price (sale prices). Never negative.
  discount          Float?
  totalAmount       Float?
  deliveryFee       Float?
  paymentStatus     PaymentStatus     @default(AWAITING)
  deliveryAddressId String?
  deliveryType      DeliveryType?
  /// Only set when deliveryType is SCHEDULED — the date the customer picked.
  scheduledDeliveryDate DateTime?
  adminNotes        String?
  cancelReason      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user            User?             @relation(fields: [userId], references: [id])
  deliveryAddress DeliveryAddress?  @relation(fields: [deliveryAddressId], references: [id])
  items           ReservationItem[]
  notifications   Notification[]
  payments        Payment[]
  statusHistory   ReservationStatusEvent[]

  @@index([reservationNumber])
  @@index([customerPhone])
  @@index([status])
  @@index([visitDate])
  @@index([fulfillmentType])
  @@index([paymentStatus])
}

model ReservationItem {
  id             String   @id @default(uuid())
  reservationId  String
  productId      String
  quantity       Int?
  metersRequired Float?
  /// Finished curtain width / drop in cm. Named "window*" historically; the
  /// configurator writes the ordered curtain's own dimensions here.
  windowWidth    Float?
  windowHeight   Float?
  unitPrice      Float?
  totalPrice     Float?
  /// The configuration the customer chose, normalised server-side by
  /// utils/productOptions.ts: colour, fabric, header type, lining, panel
  /// layout, fullness, plus a snapshot of the product name and pricing mode.
  /// A JSON column rather than columns-per-option because the option set
  /// differs per product kind and grows with the catalogue.
  options        Json?
  notes          String?
  createdAt      DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@index([reservationId])
  @@index([productId])
}

/// Append-only audit of an order's progress. One row per status or payment
/// transition, so both the customer timeline and the admin can show *when*
/// something happened rather than only the current state.
model ReservationStatusEvent {
  id            String             @id @default(uuid())
  reservationId String
  status        ReservationStatus?
  paymentStatus PaymentStatus?
  note          String?
  /// Who caused it: "customer", "admin:<userId>", or "system".
  actor         String             @default("system")
  createdAt     DateTime           @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Blog {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  content         String
  excerpt         String?
  imageUrl        String?
  imagePublicId   String?
  authorName      String
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  viewCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  translations BlogTranslation[]

  @@index([slug])
  @@index([isPublished])
}

model BlogTranslation {
  id       String  @id @default(uuid())
  blogId   String
  language String
  title    String
  content  String
  excerpt  String?

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([blogId, language])
}

model Testimonial {
  id           String   @id @default(uuid())
  customerName String
  message      String
  rating       Int      @default(5)
  imageUrl     String?
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())

  translations TestimonialTranslation[]
}

model TestimonialTranslation {
  id            String @id @default(uuid())
  testimonialId String
  language      String
  message       String

  testimonial Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@unique([testimonialId, language])
}

model Notification {
  id            String              @id @default(uuid())
  userId        String?
  reservationId String?
  channel       NotificationChannel
  status        NotificationStatus  @default(PENDING)
  subject       String?
  body          String
  recipient     String
  sentAt        DateTime?
  error         String?
  createdAt     DateTime            @default(now())

  user        User?        @relation(fields: [userId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  @@index([userId])
  @@index([reservationId])
  @@index([status])
}

model SiteContent {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  language  String   @default("en")
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([language])
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  language  String   @default("en")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id            String   @id @default(uuid())
  title         String
  subtitle      String?
  imageUrl      String
  imagePublicId String?
  linkUrl       String?
  linkText      String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model SEOSettings {
  id              String   @id @default(uuid())
  page            String   @unique
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  updatedAt       DateTime @updatedAt
}

// ─── Visual CMS ───────────────────────────────────────────────────────────────
// Content is addressed by the same dotted keys the site already uses for i18n
// ("hero.title", "about.story_p1"). A block is an *override*: when none exists
// the bundled locale JSON is served, so the site renders correctly against an
// empty database and no bulk migration is required to adopt the CMS.

enum ContentType {
  TEXT // single-line plain text
  RICHTEXT // sanitised HTML from the rich text editor
  IMAGE // { url, alt, publicId?, width?, height? }
  LINK // { href, label, external? }
  ICON // lucide icon name
  NUMBER // statistics and counters
  COLOR // theme colours
  JSON // repeatable collections: cards, nav items, footer links
}

model ContentBlock {
  id     String      @id @default(uuid())
  key    String
  locale String      @default("en")
  type   ContentType @default(TEXT)

  // draftValue is what edit mode and preview read; publishedValue is what the
  // public site reads. They diverge exactly while there are unpublished edits.
  draftValue     Json?
  publishedValue Json?

  // Optional metadata, used by the CMS search UI. Neither affects rendering.
  page  String?
  label String?

  publishedAt DateTime?
  scheduledAt DateTime?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  updatedBy User?             @relation("ContentBlockEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  revisions ContentRevision[]

  @@unique([key, locale])
  @@index([locale])
  @@index([page])
  // Partial-index candidate: only rows with a schedule are ever scanned here.
  @@index([scheduledAt])
}

// One row per publish, so history can be listed, compared and restored.
model ContentRevision {
  id          String   @id @default(uuid())
  blockId     String
  value       Json?
  label       String?
  createdById String?
  createdAt   DateTime @default(now())

  block     ContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("ContentRevisionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([blockId, createdAt])
}

model MediaFolder {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())

  parent   MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MediaFolder[] @relation("MediaFolderTree")
  assets   MediaAsset[]

  @@unique([parentId, name])
}

model MediaAsset {
  id           String   @id @default(uuid())
  url          String
  publicId     String? // Cloudinary asset id, or "local:folder/file"
  filename     String
  mimeType     String
  bytes        Int      @default(0)
  width        Int?
  height       Int?
  alt          String?
  tags         String[] @default([])
  folderId     String?
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  folder     MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy User?        @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([folderId])
  @@index([createdAt])
  @@index([filename])
}

// Global, non-localised configuration: theme colours, logo, favicon, analytics
// id, maintenance mode. Keyed by dotted name like content blocks.
model SiteSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("SiteSettingEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}
